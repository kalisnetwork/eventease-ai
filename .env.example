# EventEase AI — environment variables
# Copy to `.env.local` for local development. Never commit real values.

# Supabase project URL (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon/publishable key (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Generative AI (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY="your-gemini-api-key"

# Optional: model override
# AI_MODEL="gemini-2.0-flash"

# Database password is NOT stored here. The Supabase CLI asks for it when
# running `db push`/`db pull`. Keep it in a password manager.
